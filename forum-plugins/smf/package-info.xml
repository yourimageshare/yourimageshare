<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>yourimageshare:forumupload</id>
	<name>YourImageShare Upload</name>
	<version>1.1.0</version>
	<type>modification</type>

	<install for="2.0 - 2.1.99">
		<readme type="file" parsebbc="true">readme.txt</readme>
		<require-file name="yis_forumupload.php" destination="$sourcedir" />
		<code>install.php</code>
	</install>

	<uninstall for="2.0 - 2.1.99">
		<code>uninstall.php</code>
		<remove-file name="$sourcedir/yis_forumupload.php" />
	</uninstall>

</package-info>
