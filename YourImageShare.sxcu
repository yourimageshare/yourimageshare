{
  "Version": "17.0.0",
  "Name": "YourImageShare",
  "DestinationType": "ImageUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://yourimageshare.com/api",
  "Headers": {
    "X-API-Key": "YOUR_API_KEY"
  },
  "Body": "MultipartFormData",
  "FileFormName": "uploads",
  "URL": "$json:data.src$",
  "ThumbnailURL": "$json:data.thumb$",
  "ErrorMessage": "$json:errors$",
  "DeletionURL": "$json:data.delete_url$"
}
